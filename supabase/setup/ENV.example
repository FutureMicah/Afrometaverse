# Paste these into Lovable env / local .env (values from YOUR Supabase project)
# Dashboard → Project Settings → API

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=
SUPABASE_URL=

# anon / public key (safe for browser)
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Project ref id (optional; subdomain of the URL)
VITE_SUPABASE_PROJECT_ID=
SUPABASE_PROJECT_ID=

# Service role — server only, NEVER expose in the browser
SUPABASE_SERVICE_ROLE_KEY=

# Optional: only if you deploy avatar-3d edge function with Lovable AI
# LOVABLE_API_KEY=
